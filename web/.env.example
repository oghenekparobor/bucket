# Bucket web — copy to .env.local and fill in.

# Backend API (architecture.md §3). Server-side rendering uses API_URL when set (e.g. an internal URL).
NEXT_PUBLIC_API_URL=http://localhost:4000
# API_URL=http://backend:4000

# mock | live | auto (default). auto = live in production; in dev, live if /v1/health answers, else mock fixtures.
NEXT_PUBLIC_API_MODE=auto

# Privy. Leave empty to use dev auth (local ed25519 keypair in localStorage).
NEXT_PUBLIC_PRIVY_APP_ID=
# NEXT_PUBLIC_PRIVY_CLIENT_ID=
# dev | privy. Defaults to privy when an app id is set, else dev.
# NEXT_PUBLIC_AUTH_MODE=dev

# Solana cluster the wallet signs for: devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional: the USDC mint, used for the Solana Pay deposit link on /account.
# NEXT_PUBLIC_USDC_MINT=
# Show "Card or bank" via Privy funding on /account (requires funding enabled in the Privy dashboard).
NEXT_PUBLIC_ENABLE_CARD_FUNDING=false

# Public site origin, used for share links and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Short host shown on share links and PnL cards. Defaults to the host of NEXT_PUBLIC_SITE_URL;
# set this only to a domain that actually serves this site (the design shows bucket.xyz).
# NEXT_PUBLIC_SHARE_HOST=
