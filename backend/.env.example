# Copy to backend/.env (gitignored). Every value below is optional; defaults are shown.

# ── Service ──────────────────────────────────────────────────────────────────
# NODE_ENV=development
# LOG_LEVEL=info
# HOST=0.0.0.0
# PORT=4000
DATABASE_URL=postgres://localhost:5432/bucket_dev

# ── Chain ────────────────────────────────────────────────────────────────────
# localnet | devnet | mainnet-beta. Program id, mock USDC, fee wallet and RPC default from
# vault/deployments/<cluster>.json when it exists; set the variables below to override.
CLUSTER=localnet
# DEPLOYMENT_PATH=../vault/deployments/localnet.json
# RPC_URL=http://127.0.0.1:8899
# PROGRAM_ID=
# USDC_MINT=
# PLATFORM_FEE_WALLET=
# Public origin of this API. Wallets fetch a bucket token's metadata JSON and image from here, so on
# a deployment it must be the real public URL, not localhost.
# PUBLIC_API_URL=http://localhost:4000
# Role keys, two ways. Either the secret itself — the Solana CLI's JSON array, or those same bytes
# base64-encoded (`base64 -i keys/fee-payer.json`), which is what containers and secret managers
# want — or a path to a keypair file. The inline value wins; the paths default to ../keys/<name>.json
# when those files exist, which is what local development uses.
# FEE_PAYER_KEYPAIR=[12,34,...]   or   FEE_PAYER_KEYPAIR=Base64Secret==
# KEEPER_KEYPAIR=
# PRICE_AUTHORITY_KEYPAIR=
# FEE_PAYER_KEYPAIR_PATH=../keys/fee-payer.json
# KEEPER_KEYPAIR_PATH=../keys/keeper.json
# PRICE_AUTHORITY_KEYPAIR_PATH=../keys/price-authority.json

# ── Web ──────────────────────────────────────────────────────────────────────
# Comma-separated CORS origins, and the base of share links (shareUrl = PUBLIC_WEB_URL/b/<slug>).
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────────
# privy: Privy access tokens only. dev: also accepts `dev:<wallet>:<unix_ts>:<sig>` bearer tokens.
AUTH_MODE=dev
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Signing secret of the Privy dashboard webhook ("whsec_..."). Without it POST /v1/webhooks/privy
# answers 503 and profile changes (X linked, email changed, account deleted) only sync when the
# user next signs in.
PRIVY_WEBHOOK_SECRET=
# DEV_AUTH_MAX_AGE_SECS=86400
# WRITE_RATE_LIMIT_PER_MIN=30

# ── Geo-restrictions (config/geo-restrictions.json) ──────────────────────────
# GEO_COUNTRY_HEADERS=cf-ipcountry,x-vercel-ip-country
# GEO_REGION_HEADERS=cf-region-code,x-vercel-ip-country-region

# ── Catalog, prices and quotes ───────────────────────────────────────────────
# JUPITER_API_BASE=https://lite-api.jup.ag
# JUPITER_MIN_INTERVAL_MS=300
# PRESTOCKS_URL=https://prestocks.com/api/prestocks
# TESSERA_URL=https://rest-api.tessera.pe/v1/public/token-details
# LIQUIDITY_FLOOR_USD=250000
# MAX_PRICE_IMPACT_PCT=1
# REQUIRE_QUOTE_PROBE=false
# MAX_MIN_TRADE_USD=1
# MOCK_SWAP_FEE_BPS=30
# MINT_FEE_BPS=20
# REDEEM_FEE_BPS=0
# MIN_DEPOSIT_USD=1
# MIN_CREATOR_DEPOSIT_USD=25

# ── Leaderboard and cards ────────────────────────────────────────────────────
# Phase 2 eligibility rules (14 days, $25 creator stake, liquid holdings, open) filter the ranking.
# LEADERBOARD_ENFORCE_ELIGIBILITY=false
# CARD_CACHE_TTL_SECS=300

# ── Keeper ───────────────────────────────────────────────────────────────────
# KEEPER_INTERVAL_MS=5000
# KEEPER_MIN_SOL=0.5
# FEE_PAYER_MIN_SOL=1
# KEEPER_REBALANCE=false
# POOL_GAP_ALERT_PCT=1

# ── Alerts and notifications ─────────────────────────────────────────────────
# Slack-compatible webhook ({ text, level, code, key, context }).
ALERT_WEBHOOK_URL=
# Email is log-only unless a Resend key is set; Telegram needs a bot token.
RESEND_API_KEY=
# EMAIL_FROM=Bucket <notifications@bucket.xyz>
TELEGRAM_BOT_TOKEN=
