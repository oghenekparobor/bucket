# Copy to .env next to docker-compose.yml and fill in. Never commit the result.
#
# Role keys go in as secrets rather than files. Print one from a Solana CLI keypair with either:
#   cat keys/fee-payer.json                  # the JSON array, paste as-is
#   base64 -i keys/fee-payer.json            # same bytes, one line, friendlier to secret managers
# The backend accepts both. A blank value means "this process has no such key".

# Database. DATABASE_URL is what the backend actually reads; POSTGRES_PASSWORD only initialises the
# Postgres container that docker-compose.yml bundles for local and staging use.
#
#   Bundled Postgres: keep the host as `db` and put the SAME password in both lines below.
#   Managed Postgres (production): set DATABASE_URL to your provider's URL — usually with ?sslmode=require —
#   and ignore POSTGRES_PASSWORD; the bundled `db` service goes unused and can be deleted.
DATABASE_URL=postgres://bucket:change-me@db:5432/bucket
POSTGRES_PASSWORD=change-me

# POSTGRES_PORT=5432
# API_PORT=4000
# WEB_PORT=3000

CLUSTER=devnet
# A dedicated RPC endpoint. The public one rate-limits (429) hard enough to stall indexing and fills.
RPC_URL=

# Pays network fees for every sponsored transaction. Needs SOL.
FEE_PAYER_KEYPAIR=
# Fills mint and redeem orders. Needs SOL. Only the keeper process uses it.
KEEPER_KEYPAIR=
# Pushes prices into the program's Asset feeds. Used by the worker.
PRICE_AUTHORITY_KEYPAIR=

PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Set this to enable POST /v1/webhooks/privy; it answers 503 until then.
PRIVY_WEBHOOK_SECRET=

RESEND_API_KEY=
ALERT_WEBHOOK_URL=

# Public origins. WEB_ORIGIN is the CORS allow-list; PUBLIC_WEB_URL is used in links Bucket sends out.
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# Compiled into the web bundle at build time — change one and rebuild the web image.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_MODE=auto
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_CARD_FUNDING=false
